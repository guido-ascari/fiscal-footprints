@article{COCHRANE20221,
title = {A fiscal theory of monetary policy with partially-repaid long-term debt},
journal = {Review of Economic Dynamics},
volume = {45},
pages = {1-21},
year = {2022},
issn = {1094-2025},
doi = {https://doi.org/10.1016/j.red.2021.06.001},
url = {https://www.sciencedirect.com/science/article/pii/S1094202521000430},
author = {John H. Cochrane},
keywords = {Fiscal theory of the price level, Monetary policy, Fiscal policy, Inflation},
abstract = {I construct a simple model with sticky prices and interest rate targets, closed by fiscal theory of the price level with long-term debt and fiscal and monetary policy rules. Fiscal surpluses rise following deficits, to repay accumulated debt, but surpluses do not respond to all values of unexpected inflation and deflation. This specification avoids common puzzles and produces reasonable responses to fiscal and monetary policy shocks. It allows an easy translation of any new-Keynesian model, and it allows one to study a whole sample with active fiscal policy.}
}

@article{Woodford2001,
 ISSN = {00222879, 15384616},
 URL = {http://www.jstor.org/stable/2673890},
 abstract = {Maintaining price stability requires not only commitment to an appropriate monetary policy rule, but an appropriate fiscal policy rule as well. Ricardian equivalence does not imply that fiscal policy is irrelevant, except in the case of a certain class of policies ("Ricardian" policies). The role of fiscal developments in inflation determination under a non- Ricardian regime is illustrated through an analysis of the bond-price support regime of the 1940s. A monetary-fiscal regime with attractive properties would combine a "Taylor rule" for monetary policy with nominal- deficit targeting as a fiscal policy commitment.},
 author = {Michael Woodford},
 journal = {Journal of Money, Credit and Banking},
 number = {3},
 pages = {669--728},
 publisher = {[Wiley, Ohio State University Press]},
